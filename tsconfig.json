{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "react", "jest"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["plugins/*/src/**/*.ts", "plugins/*/src/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "plugins/pi-latex-workbench/vendor"]
}
