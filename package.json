    "@cognia/github-bot-kit": "file:.vendor/authoring-kit/cognia-github-bot-kit-0.0.0.tgz",
    "react": "19.3.1",
    "lucide-react": "1.52.0",
    "docx": "9.9.0",
    "jszip": "3.10.2",
    "@formulajs/formulajs": "4.6.1",
    "exceljs": "4.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "pdfjs-dist": "6.3.289",
    "zod": "4.6.5",
    "@novnc/novnc": "1.6.0",
    "dexie": "4.4.6",
