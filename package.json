{
  "name": "cognia-plugins",
  "private": true,
  "description": "First-party Cognia plugins: sources, packager and artifact producer",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/build.mjs",
    "produce": "node scripts/plugin/artifacts/produce.mjs --kit .vendor/authoring-kit --repository cognia-labs/cognia-plugins --out artifact",
    "typecheck": "tsc6 -p tsconfig.json",
    "test": "jest",
    "test:node": "node scripts/test-node.mjs",
    "test:python": "node scripts/test-python.mjs"
  },
  "dependencies": {
    "@cognia/plugin-sdk": "file:.vendor/authoring-kit/cognia-plugin-sdk-0.3.0.tgz",
